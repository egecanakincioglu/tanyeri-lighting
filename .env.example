# Copy to .env and adjust. Never commit real values.

# Pooled connection used by the running app.
# Local: the Postgres from `pnpm db:up` (passwordless, bound to 127.0.0.1 only).
# Production: the pooled Neon address.
DATABASE_URL=postgresql://postgres@localhost:5432/tanyeri

# Direct (unpooled) connection used by migrations and the CLI.
# Local: same database as above.
# Production: the unpooled Neon address.
DATABASE_URL_UNPOOLED=postgresql://postgres@localhost:5432/tanyeri

# Secret that signs and encrypts authentication data. At least 32 characters; generate one with
# `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`. A different value per environment.
BETTER_AUTH_SECRET=replace-me-with-at-least-32-random-characters

# The site's own address (scheme and host, no path). It is the only origin the auth routes trust.
# Local: http://localhost:3000. Production: the public https address.
BETTER_AUTH_URL=http://localhost:3000

# Search-engine indexing: "off" (default) sends noindex, "on" lets crawlers index the site.
# Stays off until the 1.0.0 release.
SITE_INDEXING=off

# File storage (Vercel Blob). Optional: without it uploads are off and the panel says so.
# Local: the read-write token of a separate development Blob store, never the production one.
BLOB_READ_WRITE_TOKEN=
