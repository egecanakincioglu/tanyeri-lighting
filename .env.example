# Copy to .env and adjust. Never commit real values.

# Pooled connection used by the running app (production: the pooled Neon address).
DATABASE_URL=postgresql://postgres@localhost:5432/tanyeri

# Direct connection used by migrations and the CLI (production: the unpooled Neon address).
DATABASE_URL_UNPOOLED=postgresql://postgres@localhost:5432/tanyeri

# Signs and encrypts auth data. At least 32 characters, different in each environment.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=replace-me-with-at-least-32-random-characters

# The site's own origin (scheme and host, no path). The auth routes trust only this origin.
BETTER_AUTH_URL=http://localhost:3000

# "off" sends noindex, "on" lets crawlers index the site.
SITE_INDEXING=off

# Public site address, used for canonical links, the sitemap and structured data.
# Optional: on Vercel the production host is used when empty, locally http://localhost:3000.
SITE_URL=

# Vercel Blob token. Optional: without it uploads are off. Locally use a separate development store.
BLOB_READ_WRITE_TOKEN=

# "true" makes the site the public demo.
DEMO_MODE=false

# Demo only, set both or neither: a read-only admin account created by `pnpm db:seed:demo`.
# The password (at least 12 characters) is public by design, so use a throwaway value.
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=

# The first admin, created by `pnpm db:seed`. Only the seed reads these; an existing email is left unchanged.
# The password is at least 12 characters and is stored only as a hash.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-me-with-a-long-password

# SMTP, set all five or none. With none, email is off and password reset is refused.
# Port 465 uses TLS from the start, other ports use STARTTLS. SMTP_FROM is an address or "Name <address>".
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
