# Copy to .env and adjust. Never commit real values.

# Pooled connection used by the running app.
# Local: the Postgres from `pnpm db:up` (passwordless, bound to 127.0.0.1 only).
# Production: the pooled Neon address.
DATABASE_URL=postgresql://postgres@localhost:5432/tanyeri

# Direct (unpooled) connection used by migrations and the CLI.
# Local: same database as above.
# Production: the unpooled Neon address.
DATABASE_URL_UNPOOLED=postgresql://postgres@localhost:5432/tanyeri

# Secret that signs and encrypts authentication data. At least 32 characters; generate one with
# `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`. A different value per environment.
BETTER_AUTH_SECRET=replace-me-with-at-least-32-random-characters

# The site's own address (scheme and host, no path). It is the only origin the auth routes trust.
# Local: http://localhost:3000. Production: the public https address.
BETTER_AUTH_URL=http://localhost:3000

# Search-engine indexing: "off" (default) sends noindex, "on" lets crawlers index the site.
# Stays off until the 1.0.0 release.
SITE_INDEXING=off

# File storage (Vercel Blob). Optional: without it uploads are off and the panel says so.
# Local: the read-write token of a separate development Blob store, never the production one.
BLOB_READ_WRITE_TOKEN=

# Demo deployment: "false" (default) is the normal site, "true" makes it the public demo.
DEMO_MODE=false

# Demo deployment only, optional, both or neither: a read-only admin account. `pnpm db:seed:demo` creates or updates it,
# and the sign-in page shows it as "Demo hesabı" while DEMO_MODE is "true". Use a throwaway value; the password is at
# least 12 characters and is public by design.
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=

# The first admin, created by `pnpm db:seed`; only the seed reads these two, the running site does not.
# Run the seed once after the first migration. If the email already exists, the seed changes nothing.
# The password is at least 12 characters. It is stored only as a hash and is never printed.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-me-with-a-long-password

# Email (SMTP). Optional, all or none: with all five set, the password reset link is sent by email;
# with none set, email is off, the reset request is refused and recovery is a command run on the server.
# A partly set group is an error. Port 465 uses TLS from the start, other ports upgrade with STARTTLS.
# SMTP_FROM is an address or "Name <address>".
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
