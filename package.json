    "admin:reset-password": "node --env-file-if-exists=.env tooling/scripts/admin-reset-password.ts",
    "lint": "eslint src tooling prisma \"*.ts\" --max-warnings 0",
    "db:up": "node tooling/scripts/db.ts up",
    "db:down": "node tooling/scripts/db.ts down",
    "knip": "knip",
    "release:prepare": "node tooling/scripts/release-prepare.ts",
    "site-audit": "node tooling/site-audit/run.ts",
    "typecheck": "next typegen && tsc --noEmit && tsc --noEmit -p tsconfig.tooling.json",
    "test": "vitest run --coverage",
    "format": "prettier --write . --ignore-path .gitignore --ignore-path .prettierignore --ignore-path .git/info/exclude",
    "format:check": "prettier --check . --ignore-path .gitignore --ignore-path .prettierignore --ignore-path .git/info/exclude"
  },
