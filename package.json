{
  "name": "tanyeri-lighting",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.12.0 <25"
  },
  "packageManager": "pnpm@12.15.0+sha512.b3951d6d6ff4a9f13dc7cf56cd28d2b8eb37dbcc9c68e52e1e1191873ea9f82a017287ab50baadc5ccc494f036c67c0e47eb13608c2fa36f47711b61ea128e61",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "lint": "eslint src tooling \"*.ts\" --max-warnings 0",
    "db:up": "node tooling/scripts/db.ts up",
    "db:down": "node tooling/scripts/db.ts down",
    "knip": "knip",
    "site-audit": "node tooling/site-audit/run.ts",
    "typecheck": "next typegen && tsc --noEmit && tsc --noEmit -p tsconfig.tooling.json",
    "test": "vitest run --coverage",
    "format": "prettier --write . --ignore-path .gitignore --ignore-path .prettierignore --ignore-path .git/info/exclude",
    "format:check": "prettier --check . --ignore-path .gitignore --ignore-path .prettierignore --ignore-path .git/info/exclude"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.5",
    "axe-core": "4.14.0",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.3",
    "jsdom": "30.1.3",
    "knip": "6.43.0",
    "lighthouse": "13.5.0",
    "pg": "8.23.1",
    "prettier": "3.9.10",
    "prisma": "7.10.1",
    "puppeteer-core": "25.16.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "next": "16.4.3",
    "next-intl": "4.14.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  }
}
