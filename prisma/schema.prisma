generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  isDemo        Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model RateLimit {
  id          String @id
  key         String
  count       Int
  lastRequest BigInt

  @@unique([key])
  @@map("rateLimit")
}

// Counters of the project's own rate limiter; Better Auth keeps its own in "rateLimit".
model RateLimitCounter {
  key         String   @id
  windowStart DateTime
  count       Int

  @@index([windowStart])
  @@map("rateLimitCounter")
}

// No IP address or browser identification string is kept. "locale" is the visitor's language, so a reply can use it.
model ContactMessage {
  id        String    @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  locale    String
  createdAt DateTime  @default(now())
  readAt    DateTime?

  @@index([createdAt])
  @@map("contactMessage")
}

// One row per day and anonymized address, so a client cannot grow the table.
// The address is cut to /24 (IPv4) or /48 (IPv6).
// No path, referrer or browser identification string is kept. The day is the Europe/Istanbul day; rows live 13 months.
model Visit {
  id      String   @id @default(cuid())
  day     DateTime @db.Date
  address String
  country String?
  city    String?
  views   Int      @default(1)

  @@unique([day, address])
  @@index([day])
  @@map("visit")
}

// Every bilingual field is two required columns, `<field>Tr` and `<field>En`;
// a page never falls back to the other language.

// Business contact and identity details. At most one row, id "site".
model SiteSettings {
  id             String   @id
  siteNameTr     String
  siteNameEn     String
  logoUrl        String?
  phone          String
  email          String
  addressTr      String
  addressEn      String
  workingHoursTr String
  workingHoursEn String
  serviceAreaTr  String
  serviceAreaEn  String
  languagesTr    String
  languagesEn    String
  updatedAt      DateTime @updatedAt

  @@map("siteSettings")
}

model SocialLink {
  id        String   @id @default(uuid(7))
  platform  String
  labelTr   String
  labelEn   String
  url       String
  position  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([position])
  @@map("socialLink")
}

// Title and description of a public page; the key is a PAGE_KEYS value.
model PageMetadata {
  pageKey       String   @id
  titleTr       String
  titleEn       String
  descriptionTr String
  descriptionEn String
  updatedAt     DateTime @updatedAt

  @@map("pageMetadata")
}

// The legal pages, keyed "privacy" and "terms". Bodies are limited Markdown as plain text.
model LegalPage {
  pageKey   String   @id
  titleTr   String
  titleEn   String
  bodyTr    String
  bodyEn    String
  updatedAt DateTime @updatedAt

  @@map("legalPage")
}

// A job with before and after pictures. The description is limited Markdown as plain text.
model Project {
  id             String   @id @default(uuid(7))
  titleTr        String
  titleEn        String
  descriptionTr  String
  descriptionEn  String
  beforeImageUrl String
  afterImageUrl  String
  sortOrder      Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([sortOrder])
  @@map("project")
}

// A client or partner. The name is a proper name and is not translated.
model Reference {
  id            String   @id @default(uuid(7))
  imageUrl      String
  imageAltTr    String   @default("")
  imageAltEn    String   @default("")
  name          String
  titleTr       String
  titleEn       String
  descriptionTr String
  descriptionEn String
  sortOrder     Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([sortOrder])
  @@map("reference")
}

// Product categories, at most 8. The key is language independent and filters the product list in a URL.
model Category {
  id               String            @id @default(uuid(7))
  key              String            @unique
  nameTr           String
  nameEn           String
  sortOrder        Int
  // Empty strings fall back to the category name. The title has no brand: the site template adds it.
  seoTitleTr       String            @default("")
  seoTitleEn       String            @default("")
  seoDescriptionTr String            @default("")
  seoDescriptionEn String            @default("")
  h1Tr             String            @default("")
  h1En             String            @default("")
  introTr          String            @default("")
  introEn          String            @default("")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  products         Product[]
  areas            ApplicationArea[]

  @@map("category")
}

// A product has no price. `sortOrder` counts within the category. A category with products cannot be deleted.
model Product {
  id               String                @id @default(uuid(7))
  categoryId       String
  category         Category              @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  slug             String                @unique
  code             String                @unique
  nameTr           String
  nameEn           String
  colorTr          String
  colorEn          String
  materialTr       String
  materialEn       String
  power            String
  dimensions       String
  descriptionTr    String                @default("")
  descriptionEn    String                @default("")
  luminousFlux     String                @default("")
  colorTemperature String                @default("")
  cri              String                @default("")
  ip               String                @default("")
  imageUrl         String
  sortOrder        Int
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  redirects        ProductSlugRedirect[]
  featured         FeaturedProduct?

  @@index([categoryId, sortOrder])
  @@map("product")
}

// An earlier product slug, kept so the old address redirects.
model ProductSlugRedirect {
  id        String   @id @default(uuid(7))
  oldSlug   String   @unique
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([productId])
  @@map("productSlugRedirect")
}

// A downloadable PDF catalog. The row keeps the file's address and size.
model Catalog {
  id            String       @id @default(uuid(7))
  nameTr        String
  nameEn        String
  pdfUrl        String
  coverImageUrl String
  imageAltTr    String       @default("")
  imageAltEn    String       @default("")
  sizeBytes     Int
  sortOrder     Int
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  promoBoards   PromoBoard[]

  @@index([sortOrder])
  @@map("catalog")
}

// The home page banner. At most one row, id "home". Each action is a button to a public page (a PAGE_KEYS value).
model HomeBanner {
  id               String   @id
  imageUrl         String
  imageAltTr       String   @default("")
  imageAltEn       String   @default("")
  titleTr          String
  titleEn          String
  descriptionTr    String
  descriptionEn    String
  primaryLabelTr   String
  primaryLabelEn   String
  primaryTarget    String
  secondaryLabelTr String
  secondaryLabelEn String
  secondaryTarget  String
  updatedAt        DateTime @updatedAt

  @@map("homeBanner")
}

// Products on the home page, in display order. Deleting a product removes it from the list.
model FeaturedProduct {
  id        String   @id @default(uuid(7))
  productId String   @unique
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sortOrder Int
  createdAt DateTime @default(now())

  @@index([sortOrder])
  @@map("featuredProduct")
}

// A home page picture that links to a catalog. A catalog linked from a board cannot be deleted.
model PromoBoard {
  id         String   @id @default(uuid(7))
  imageUrl   String
  imageAltTr String   @default("")
  imageAltEn String   @default("")
  titleTr    String
  titleEn    String
  // Both empty when the board has no subtitle.
  subtitleTr String
  subtitleEn String
  catalogId  String
  catalog    Catalog  @relation(fields: [catalogId], references: [id], onDelete: Restrict)
  sortOrder  Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([sortOrder])
  @@index([catalogId])
  @@map("promoBoard")
}

// A kind of place the business lights. The description is short plain text.
model ApplicationArea {
  id            String    @id @default(uuid(7))
  imageUrl      String
  imageAltTr    String    @default("")
  imageAltEn    String    @default("")
  titleTr       String
  titleEn       String
  descriptionTr String
  descriptionEn String
  sortOrder     Int
  // The home card links to this category; none leaves it unlinked.
  categoryId    String?
  category      Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([sortOrder])
  @@map("applicationArea")
}

// A card of the services page. The description is limited Markdown as plain text.
// The note is optional: both columns are empty, never only one.
model Service {
  id            String   @id @default(uuid(7))
  imageUrl      String
  imageAltTr    String   @default("")
  imageAltEn    String   @default("")
  titleTr       String
  titleEn       String
  descriptionTr String
  descriptionEn String
  noteTr        String
  noteEn        String
  sortOrder     Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([sortOrder])
  @@map("service")
}

// The about page, with the vision as a section. At most one row, id "about".
// Both texts are limited Markdown as plain text.
model AboutPage {
  id        String   @id
  bodyTr    String
  bodyEn    String
  visionTr  String
  visionEn  String
  updatedAt DateTime @updatedAt

  @@map("aboutPage")
}

// A blog article. Public only while publishedAt is set and not in the future; otherwise a draft.
// The body is limited Markdown as plain text.
model BlogPost {
  id            String                 @id @default(uuid(7))
  slug          String                 @unique
  titleTr       String
  titleEn       String
  descriptionTr String
  descriptionEn String
  excerptTr     String
  excerptEn     String
  bodyTr        String
  bodyEn        String
  imageUrl      String
  imageAltTr    String
  imageAltEn    String
  publishedAt   DateTime?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  redirects     BlogPostSlugRedirect[]

  @@index([publishedAt])
  @@map("blog_post")
}

// An earlier blog slug, kept so the old address redirects.
model BlogPostSlugRedirect {
  id        String   @id @default(uuid(7))
  oldSlug   String   @unique
  postId    String
  post      BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([postId])
  @@map("blogPostSlugRedirect")
}
