generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model RateLimit {
  id          String @id
  key         String
  count       Int
  lastRequest BigInt

  @@unique([key])
  @@map("rateLimit")
}

// Counters of the project's own rate limiter (src/server/rate-limit); Better Auth keeps its own in "rateLimit".
model RateLimitCounter {
  key         String   @id
  windowStart DateTime
  count       Int

  @@index([windowStart])
  @@map("rateLimitCounter")
}

// Messages from the public contact form. No IP address and no browser identification string are kept; "locale" is
// the language the visitor used on the site ("tr" or "en"), so a reply can be written in it.
model ContactMessage {
  id        String    @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  locale    String
  createdAt DateTime  @default(now())
  readAt    DateTime?

  @@index([createdAt])
  @@map("contactMessage")
}

// Every bilingual field below is two required columns, `<field>Tr` and `<field>En`; a page never falls back from one
// language to the other (ADR 0006). src/server/content maps them to a { tr, en } pair.

// Contact and identity details of the business. At most one row, with the fixed id "site".
model SiteSettings {
  id             String   @id
  siteNameTr     String
  siteNameEn     String
  logoUrl        String?
  phone          String
  email          String
  addressTr      String
  addressEn      String
  workingHoursTr String
  workingHoursEn String
  serviceAreaTr  String
  serviceAreaEn  String
  languagesTr    String
  languagesEn    String
  updatedAt      DateTime @updatedAt

  @@map("siteSettings")
}

model SocialLink {
  id        String   @id @default(uuid(7))
  platform  String
  labelTr   String
  labelEn   String
  url       String
  position  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([position])
  @@map("socialLink")
}

// Title and description of a public page. The key is one of PAGE_KEYS in src/server/content/schemas.ts.
model PageMetadata {
  pageKey       String   @id
  titleTr       String
  titleEn       String
  descriptionTr String
  descriptionEn String
  updatedAt     DateTime @updatedAt

  @@map("pageMetadata")
}

// The legal pages, keyed "privacy" and "terms". The bodies are limited Markdown stored as plain text.
model LegalPage {
  pageKey   String   @id
  titleTr   String
  titleEn   String
  bodyTr    String
  bodyEn    String
  updatedAt DateTime @updatedAt

  @@map("legalPage")
}

// A finished job shown with a before and an after picture. The description is limited Markdown stored as plain text.
model Project {
  id             String   @id @default(uuid(7))
  titleTr        String
  titleEn        String
  descriptionTr  String
  descriptionEn  String
  beforeImageUrl String
  afterImageUrl  String
  sortOrder      Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([sortOrder])
  @@map("project")
}

// A client or partner shown on the site. The name is a proper name and is not translated; the title says what kind of
// work it was.
model Reference {
  id            String   @id @default(uuid(7))
  imageUrl      String
  name          String
  titleTr       String
  titleEn       String
  descriptionTr String
  descriptionEn String
  sortOrder     Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([sortOrder])
  @@map("reference")
}

// Product categories (at most 8, enforced in src/server/content/categories.ts). The key is language independent and
// is used to filter the product list in a URL.
model Category {
  id        String    @id @default(uuid(7))
  key       String    @unique
  nameTr    String
  nameEn    String
  sortOrder Int
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]

  @@map("category")
}

// A product has no price. The slug is the language-independent address of its page; `sortOrder` counts within the
// category. A category with products cannot be deleted.
model Product {
  id         String                @id @default(uuid(7))
  categoryId String
  category   Category              @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  slug       String                @unique
  code       String                @unique
  nameTr     String
  nameEn     String
  colorTr    String
  colorEn    String
  materialTr String
  materialEn String
  power      String
  dimensions String
  imageUrl   String
  sortOrder  Int
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt
  redirects  ProductSlugRedirect[]

  @@index([categoryId, sortOrder])
  @@map("product")
}

// An earlier slug of a product, kept so the old address answers with a redirect to the current one.
model ProductSlugRedirect {
  id        String   @id @default(uuid(7))
  oldSlug   String   @unique
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([productId])
  @@map("productSlugRedirect")
}

// A downloadable PDF catalog. The file itself is stored by the storage module; this row keeps its address and size.
model Catalog {
  id        String   @id @default(uuid(7))
  nameTr    String
  nameEn    String
  pdfUrl    String
  sizeBytes Int
  sortOrder Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
  @@map("catalog")
}
