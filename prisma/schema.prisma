generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model RateLimit {
  id          String @id
  key         String
  count       Int
  lastRequest BigInt

  @@unique([key])
  @@map("rateLimit")
}

// Counters of the project's own rate limiter (src/server/rate-limit); Better Auth keeps its own in "rateLimit".
model RateLimitCounter {
  key         String   @id
  windowStart DateTime
  count       Int

  @@index([windowStart])
  @@map("rateLimitCounter")
}

// Messages from the public contact form. No IP address and no browser identification string are kept; "locale" is
// the language the visitor used on the site ("tr" or "en"), so a reply can be written in it.
model ContactMessage {
  id        String    @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  locale    String
  createdAt DateTime  @default(now())
  readAt    DateTime?

  @@index([createdAt])
  @@map("contactMessage")
}

// Every bilingual field below is two required columns, `<field>Tr` and `<field>En`; a page never falls back from one
// language to the other (ADR 0006). src/server/content maps them to a { tr, en } pair.

// Contact and identity details of the business. At most one row, with the fixed id "site".
model SiteSettings {
  id             String   @id
  siteNameTr     String
  siteNameEn     String
  logoUrl        String?
  phone          String
  email          String
  addressTr      String
  addressEn      String
  workingHoursTr String
  workingHoursEn String
  serviceAreaTr  String
  serviceAreaEn  String
  languagesTr    String
  languagesEn    String
  updatedAt      DateTime @updatedAt

  @@map("siteSettings")
}

model SocialLink {
  id        String   @id @default(uuid(7))
  platform  String
  labelTr   String
  labelEn   String
  url       String
  position  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([position])
  @@map("socialLink")
}

// Title and description of a public page. The key is one of PAGE_KEYS in src/server/content/schemas.ts.
model PageMetadata {
  pageKey       String   @id
  titleTr       String
  titleEn       String
  descriptionTr String
  descriptionEn String
  updatedAt     DateTime @updatedAt

  @@map("pageMetadata")
}

// The legal pages, keyed "privacy" and "terms". The bodies are limited Markdown stored as plain text.
model LegalPage {
  pageKey   String   @id
  titleTr   String
  titleEn   String
  bodyTr    String
  bodyEn    String
  updatedAt DateTime @updatedAt

  @@map("legalPage")
}

// A finished job shown with a before and an after picture. The description is limited Markdown stored as plain text.
model Project {
  id             String   @id @default(uuid(7))
  titleTr        String
  titleEn        String
  descriptionTr  String
  descriptionEn  String
  beforeImageUrl String
  afterImageUrl  String
  sortOrder      Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([sortOrder])
  @@map("project")
}

// A client or partner shown on the site. The name is a proper name and is not translated; the title says what kind of
// work it was.
model Reference {
  id            String   @id @default(uuid(7))
  imageUrl      String
  name          String
  titleTr       String
  titleEn       String
  descriptionTr String
  descriptionEn String
  sortOrder     Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([sortOrder])
  @@map("reference")
}

// Product categories (at most 8, enforced in src/server/content/categories.ts). The key is language independent and
// is used to filter the product list in a URL.
model Category {
  id        String    @id @default(uuid(7))
  key       String    @unique
  nameTr    String
  nameEn    String
  sortOrder Int
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]

  @@map("category")
}

// A product has no price. The slug is the language-independent address of its page; `sortOrder` counts within the
// category. A category with products cannot be deleted.
model Product {
  id         String                @id @default(uuid(7))
  categoryId String
  category   Category              @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  slug       String                @unique
  code       String                @unique
  nameTr     String
  nameEn     String
  colorTr    String
  colorEn    String
  materialTr String
  materialEn String
  power      String
  dimensions String
  imageUrl   String
  sortOrder  Int
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt
  redirects  ProductSlugRedirect[]
  featured   FeaturedProduct?

  @@index([categoryId, sortOrder])
  @@map("product")
}

// An earlier slug of a product, kept so the old address answers with a redirect to the current one.
model ProductSlugRedirect {
  id        String   @id @default(uuid(7))
  oldSlug   String   @unique
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([productId])
  @@map("productSlugRedirect")
}

// A downloadable PDF catalog. The file itself is stored by the storage module; this row keeps its address and size.
model Catalog {
  id            String       @id @default(uuid(7))
  nameTr        String
  nameEn        String
  pdfUrl        String
  // Empty when the catalog has no cover picture.
  coverImageUrl String
  sizeBytes     Int
  sortOrder     Int
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  promoBoards   PromoBoard[]

  @@index([sortOrder])
  @@map("catalog")
}

// The banner at the top of the home page. At most one row, with the fixed id "home". Each action is a button that
// opens one of the public pages (a PAGE_KEYS value, checked in src/server/content/schemas.ts).
model HomeBanner {
  id               String   @id
  imageUrl         String
  titleTr          String
  titleEn          String
  descriptionTr    String
  descriptionEn    String
  primaryLabelTr   String
  primaryLabelEn   String
  primaryTarget    String
  secondaryLabelTr String
  secondaryLabelEn String
  secondaryTarget  String
  updatedAt        DateTime @updatedAt

  @@map("homeBanner")
}

// The products shown on the home page, in display order. A product that is deleted leaves the list.
model FeaturedProduct {
  id        String   @id @default(uuid(7))
  productId String   @unique
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sortOrder Int
  createdAt DateTime @default(now())

  @@index([sortOrder])
  @@map("featuredProduct")
}

// A picture on the home page that links to a catalog. A catalog that a board links to cannot be deleted.
model PromoBoard {
  id        String   @id @default(uuid(7))
  imageUrl  String
  titleTr   String
  titleEn   String
  catalogId String
  catalog   Catalog  @relation(fields: [catalogId], references: [id], onDelete: Restrict)
  sortOrder Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
  @@index([catalogId])
  @@map("promoBoard")
}

// A kind of place the business lights (the former "work areas"). The description is short plain text.
model ApplicationArea {
  id            String   @id @default(uuid(7))
  imageUrl      String
  titleTr       String
  titleEn       String
  descriptionTr String
  descriptionEn String
  sortOrder     Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([sortOrder])
  @@map("applicationArea")
}

// A card of the services page. The description is limited Markdown stored as plain text. The note is optional: both
// columns are empty strings when there is none, never only one of them.
model Service {
  id            String   @id @default(uuid(7))
  imageUrl      String
  titleTr       String
  titleEn       String
  descriptionTr String
  descriptionEn String
  noteTr        String
  noteEn        String
  sortOrder     Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([sortOrder])
  @@map("service")
}

// The about page, with the vision as a section of it. At most one row, with the fixed id "about". Both texts are
// limited Markdown stored as plain text.
model AboutPage {
  id        String   @id
  bodyTr    String
  bodyEn    String
  visionTr  String
  visionEn  String
  updatedAt DateTime @updatedAt

  @@map("aboutPage")
}
