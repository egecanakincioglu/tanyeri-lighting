#!/usr/bin/env bash
# Checks branch name, staged content and secrets before a commit. Installed by tooling/scripts/setup-git-hooks.sh.
set -euo pipefail
root="$(git rev-parse --show-toplevel)"
branch="$(git symbolic-ref --short HEAD 2>/dev/null || echo DETACHED)"
if [ "$branch" = "main" ]; then
  echo "pre-commit: direct commits to main are not allowed; create a branch: git switch -c <type>/<name>" >&2
  exit 1
fi
"$root/tooling/scripts/check-branch-name.sh" "$branch"
"$root/tooling/scripts/check-forbidden-terms.sh" --staged
"$root/tooling/scripts/check-forbidden-paths.sh" --staged

# The gitleaks image is read with sed so the hook does not need Node.
gitleaks_image="$(sed -n 's/^FROM \(.*\) AS gitleaks$/\1/p' "$root/tooling/ci-images/Dockerfile" | tr -d '\r')"
pinned="${gitleaks_image#*:}"
pinned="${pinned%%@*}"
pinned="${pinned#v}"
if [ -z "$gitleaks_image" ] || [ -z "$pinned" ]; then
  echo "pre-commit: cannot read the pinned gitleaks image from tooling/ci-images/Dockerfile; commit rejected" >&2
  exit 1
fi
# A PATH binary counts only at exactly the pinned version; a container engine only if its daemon answers.
# MSYS_NO_PATHCONV stops Git Bash on Windows from rewriting "-w /repo" and the volume path.
local_version=""
if command -v gitleaks >/dev/null 2>&1; then
  local_version="$(gitleaks version 2>/dev/null | tr -d '\r' | head -n 1)"
  local_version="${local_version#v}"
fi
if [ "$local_version" = "$pinned" ]; then
  gitleaks git --pre-commit --staged --redact --no-banner
elif command -v docker >/dev/null 2>&1 && docker info --format "{{.ServerVersion}}" >/dev/null 2>&1; then
  MSYS_NO_PATHCONV=1 docker run --rm -v "$root:/repo" -w /repo "$gitleaks_image" git --pre-commit --staged --redact --no-banner
elif command -v podman >/dev/null 2>&1 && podman info >/dev/null 2>&1; then
  MSYS_NO_PATHCONV=1 podman run --rm -v "$root:/repo" -w /repo "$gitleaks_image" git --pre-commit --staged --redact --no-banner
else
  echo "pre-commit: no usable secret scanner; commit rejected (the secret scan is never skipped)." >&2
  echo "  Install gitleaks $pinned (found: ${local_version:-none}) or start Docker/Podman to use the pinned image." >&2
  echo "  Run: node tooling/scripts/doctor.ts" >&2
  exit 1
fi

local_hook="$(git rev-parse --path-format=absolute --git-common-dir)/hooks/pre-commit"
if [ -x "$local_hook" ]; then
  "$local_hook" "$@"
fi
