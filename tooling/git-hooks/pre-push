#!/usr/bin/env bash
# Blocks pushing to main; main only changes through merged pull requests.
set -euo pipefail
# the ref lines arrive on stdin once; keep them so the optional local hook below can read them too
refs="$(cat)"
while read -r _local_ref _local_sha remote_ref _remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "pre-push: pushing to main is not allowed; open a pull request" >&2
    exit 1
  fi
done <<<"$refs"

# run an optional machine-local hook of the same name
local_hook="$(git rev-parse --path-format=absolute --git-common-dir)/hooks/pre-push"
if [ -x "$local_hook" ]; then
  { [ -z "$refs" ] || printf '%s\n' "$refs"; } | "$local_hook" "$@"
fi
