#!/usr/bin/env bash
# Blocks pushing to main. Installed by tooling/scripts/setup-git-hooks.sh.
set -euo pipefail
# stdin can be read once; keep the refs for the local hook below.
refs="$(cat)"
while read -r _local_ref _local_sha remote_ref _remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "pre-push: pushing to main is not allowed; open a pull request" >&2
    exit 1
  fi
done <<<"$refs"

local_hook="$(git rev-parse --path-format=absolute --git-common-dir)/hooks/pre-push"
if [ -x "$local_hook" ]; then
  { [ -z "$refs" ] || printf '%s\n' "$refs"; } | "$local_hook" "$@"
fi
